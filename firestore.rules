rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /profiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.isAdmin == false;
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.isAdmin == resource.data.isAdmin;
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.entryType in ['stag', 'couple'];

      // Admin approve/reject (pending -> verified/rejected) or check-in (verified -> checked_in)
      allow update: if isAdmin() && (
        (resource.data.status == 'pending' && request.resource.data.status in ['verified', 'rejected']) ||
        (resource.data.status == 'verified' && request.resource.data.status == 'checked_in')
      );
    }
  }
}
